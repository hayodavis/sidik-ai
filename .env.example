# Pilih minimal satu provider AI yang ingin Anda gunakan di SIDIK-AI

# 1. Groq API (Gratis & Super Cepat - Qwen 3.8 27B Vision) -> https://console.groq.com/keys
GROQ_API_KEY=

# 2. OpenRouter API (Multi-Model Vision Gratis/Murah) -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Google Gemini API -> https://aistudio.google.com/apikey
GEMINI_API_KEY=masukkan_api_key_anda_disini

# 4. Ollama Lokal (100% Offline & Unlimited, tanpa API Key)
OLLAMA_BASE_URL=http://localhost:11434
